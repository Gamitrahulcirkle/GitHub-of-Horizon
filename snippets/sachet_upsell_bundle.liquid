{% assign pc_sachet_lists = settings.pc_sachet_product %}
{% if pc_sachet_lists != blank %}  
  {% assign p = pc_sachet_lists | first %}
  {% assign vid = p.variants.first.id %}
  {% assign sachetImage = p.metafields.custom.sachet_upsell_image.value %}
  {% comment %} {% for v in p.variants %}{% if v.available %}{% assign vid = v.id %}{% break %}{% endif %}{% endfor %}
  {{ vid }} {% endcomment %}

  {% comment %}Note: Check if  only cookies & cream item in cart then show Madagascan Vanilla first and if other then show cookies & cream in select box: Start {% endcomment %}     
    {% assign cart_handles = cart.items | map: "product" | map: "handle" %}
    {% assign cookiesCreamItem = false %}

    {% if cart.items.size == 1 and cart_handles contains "organic-whey-protein-cookies-cream" %}
      {% comment %} <p>Cookies & Cream is in the cart</p> {% endcomment %}
      {% assign cookiesCreamItem = true %}
    {% endif %}

    {% unless cookiesCreamItem %}   
      {% assign sachetLists = settings.pc_sachet_product | compact %}        
      {% assign p = sachetLists[1] %}   
      {% assign vid = p.variants.first.id %}
      {% assign sachetImage = p.metafields.custom.sachet_upsell_image.value %}     
    {% endunless %}
  {% comment %} Cookies & Cream: End {% endcomment %}

  <div class="offer-box">        
    <div class="vanila_upsell new-scoop-format" id="{{ vid  }}">
      <div class="plus_svg">
        <svg width="100" height="100" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path
              d="M0 50C0 22.3858 22.3858 0 50 0C77.6142 0 100 22.3858 100 50C100 77.6142 77.6142 100 50 100C22.3858 100 0 77.6142 0 50Z"
              fill="currentColor"></path>
          <path
              d="M29.1667 54.2017V45.7983H45.5702V29.1667H54.2544V45.7983H70.8333V54.2017H54.2544V70.8333H45.5702V54.2017H29.1667Z"
              fill="#FDF9F5"></path>
        </svg>
      </div>
    </div>    
    
    <div class="offer-left">
      {% if settings.pc_sachet_img != blank %}      
        {% comment %} <img class="sachet_flavour_image"  src="{{ settings.pc_sachet_img | img_url: 'master'}}" alt="{{ settings.pc_sachet_img.alt }}"> {% endcomment %}
         {% if sachetImage != blank %}
           <img class="sachet_flavour_image"  src="{{ sachetImage | image_url }}">
          {% else %}
            <img class="sachet_flavour_image"  src="{{ p.featured_image | image_url }}">
          {% endif %}  
      {% else %}
        <img class="sachet_flavour_image" src="//theorganicproteincompany.co.uk/cdn/shop/files/vanilla-organic-whey-protein-powder-pack-shot-web.jpg?v=1745506956" alt="image">
      {% endif %}
    </div>    
    <div class="offer-content">
      <div class="dropdown">
        <select name="sachet_items" class="sachet_items">
          {% for product in pc_sachet_lists %}
            {% assign pvId = product.variants | first %}
            {% assign productTitle =  product.title | remove:"Organic Whey Protein" | remove:"(one per flavour, 25g)" | remove:" Chocolate - " %}
            {% assign sachetImage = product.metafields.custom.sachet_upsell_image.value %} 
            <option {% unless cookiesCreamItem %} {% if forloop.index == 2 %}selected{% endif %} {% endunless %} data-handle="{{ product.handle }}" 
              data-image_url="{{ sachetImage | default: product.featured_image | image_url }}" 
              value="{{ pvId.id }}"
            >{{ productTitle | replace:"Coffee","Real Coffee" }}</option>
          {% endfor %}
        </select>
      </div>
      <div class="inner-offer-content">
        <p>
          A little thank you from us: <br>
          pick any flavour to try with your order.
        </p>
        <span class="offer-free"> FREE </span>
      </div>
    </div>
  </div>

  <style>
.offer-box .vanila_upsell {
    position: absolute;
    border: none;
    margin: 0;
    padding: 0;
    top: 0;
    right: 0;
}
    .offer-box .plus_svg {
      width: 41px;
      height: 41px;
      display: flex;
      position: absolute;
      right: -10px;
      top: -15px;
      color: #487E89;
      cursor: pointer;
    }
    .offer-box .plus_svg svg {
      height: auto;
    }
    .offer-box {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border: 1px solid #487E89;
      border-radius: 7px;
      padding: 8px 23px 8px 13px;
      gap: 15px;
      background-color: #ecf1f1;
      position: relative;
    }
    .offer-left img {
      width: 100%;
      max-width: 94px;
      border-radius: 7px;
    }
    .offer-content {
      flex: 1;
    }
    .inner-offer-content {
      display: flex;
    }
    .offer-box .dropdown select {
      width: 100%;
      padding: 5px 10px 5px 6px;
      border: none;
      border-radius: 6px;
      font-size: 12px !important;
      font-weight: 400;
      outline: none;
      margin-bottom: 8px;
      background-color: #FFFFFF;
      color: #222222;
    }
    .offer-content p {
      font-size: 13px;
      color: #222222;
      line-height: 1.5;
      margin: 0;
      font-weight: 400;
        flex: 1;
    }
    .offer-free {
      font-size: 16px;
      font-weight: 400;
      text-transform: uppercase;
      line-height: 1.5;
      color: #000;
      display: flex;
    }
    @media (max-width: 576px) {
        .offer-left img {
            width: 100px;
        }
        .offer-box .plus_svg {
          width: 41px;
          height: 41px;
        }
    }
  </style>
{% endif %}