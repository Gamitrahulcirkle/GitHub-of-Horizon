{% comment %} <section class="bundle-product" data-section="bundle-product">
  <h2 class="bundle-product__title">
    {{ section.settings.heading | default: "The bundle products list" }}
  </h2>

  <div class="bundle-product__list">
    {% for block in section.blocks %}
      {% assign product = all_products[block.settings.product] %}

      {% if product %}
        <div class="bundle-item">
          <input 
            type="checkbox" 
            class="bundle-checkbox"
            data-variant-id="{{ product.variants.first.id }}"
          >

          <img src="{{ product.featured_image | img_url: '200x' }}" alt="{{ product.title }}">

          <h4>{{ product.title }}</h4>
          <p>{{ product.price | money }}</p>
        </div>
      {% endif %}
    {% endfor %}
  </div>

  <button id="bundle-add-to-cart">Add Selected to Cart</button>
</section> {% endcomment %}

<bundle-component>
  <section class="bundle-product" data-section="bundle-product">
    
    <h2 class="bundle-product__title">
      {{ section.settings.heading | default: "The bundle products list" }}
    </h2>

    <div class="bundle-product__list">
      {% for block in section.blocks %}
        {% assign product = all_products[block.settings.product] %}

        {% if product %}
          <div class="bundle-item">
            <!-- Checkbox with variant ID -->
            <input 
              type="checkbox"
              class="bundle-checkbox"
              id="bundle-{{ forloop.index }}"
              data-variant-id="{{ product.variants.first.id }}"
            >
            <!-- Product Info -->
            <label for="bundle-{{ forloop.index }}" class="bundle-item__content">              
              {% if product.featured_image %}
                <img 
                  src="{{ product.featured_image | image_url: width: 200 }}" 
                  alt="{{ product.title }}"
                  class="bundle-item__image"
                >
              {% endif %}
              <div class="bundle-item__info">
                <h4 class="bundle-item__title">{{ product.title }}</h4>
                <p class="bundle-item__price">{{ product.price | money }}</p>
              </div>
            </label>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <!-- Add Bundle Button -->
    <button 
      id="bundle-add-to-cart"
      class="bundle-add-to-cart button button--primary"
      type="button"
    >
      Add Selected Bundle
    </button>

  </section>
</bundle-component>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        class BundleComponent extends HTMLElement {
        connectedCallback() {
            this.button = this.querySelector('#bundle-add-to-cart');
            this.button?.addEventListener('click', this.handleClick.bind(this));
        }

        handleClick() {
            const selectedItems = [];

            this.querySelectorAll('.bundle-checkbox:checked').forEach((checkbox) => {
            const variantId = checkbox.dataset.variantId;

            if (variantId) {
                selectedItems.push({
                variantId: variantId,
                quantity: 1
                });
            }
            });

            if (selectedItems.length === 0) {
            alert('Select at least one product');
            return;
            }

            // 🔥 KEY PART: find nearest product form
            const productForm = this.closest('product-form-component');

            if (!productForm) {
           // console.error('ProductFormComponent not found');
            return;
            }

            // 🔥 Use internal batch method
            if (typeof productForm['#processBatchAddToCart'] === 'function') {
            // ❌ won't work (private method)
            }

            // ✅ Correct approach: dispatch event instead
            productForm.dispatchEvent(
            new CustomEvent('bundle:add', {
                detail: { items: selectedItems },
                bubbles: true
            })
            );
        }
    }

    customElements.define('bundle-component', BundleComponent);
    });
</script>
<style>
    .bundle-product__list {
        display: flex;
        justify-content: center;
        gap: 11px;
        margin: 20px 0;
    }
    .bundle-item {
        padding: 10px !important;
        background: #ffffff;
        border: 1px solid #cccccc;
        border-radius: 12px;
        text-align: center;
        color: #000000;
        transition: all 0.3s ease;
        cursor: pointer;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }
</style>
{%  schema  %}
    {
        "name": "Bundle product",
        "settings": [
            {
                "type": "text",
                "id": "heading",
                "label": "Heading"
            }
        ],
        "blocks": [
            {
                "type": "bundle-product-item",
                "name": "Bundle product item",
                "settings": [  
                    {
                        "type": "product",
                        "id": "product",
                        "label": "Product"
                    }
                 ]
            
            }
        ],
        "presets": [
            {
                "name": "Bundle Product"
            }
        ]
    }
{% endschema %}